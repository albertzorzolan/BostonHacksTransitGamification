{
  "name": "station-egg-hunt-backend",
  "version": "0.2.0",
  "private": true,
  "description": "Station Egg Hunt API (Node + MongoDB).",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
