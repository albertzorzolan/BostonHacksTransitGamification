# Copy to backend/.env and fill in.

# Postgres. Any managed Postgres works (Neon, Supabase, RDS, ...). Required.
DATABASE_URL=postgres://localhost:5432/egg_hunt
# Connections per instance. Keep instances x pool size under the database's limit.
DB_POOL_SIZE=10
# Only used by `npm test`; each run makes and drops its own schema here.
TEST_DATABASE_URL=postgres://localhost:5432/egg_hunt_test

# Browser origins allowed to call the API, comma-separated, or * for any.
# Auth uses bearer tokens (not cookies), so * is safe for development.
CORS_ORIGINS=*
# The API also serves ../frontend by default. Set false when the frontend is hosted elsewhere.
SERVE_FRONTEND=true

# Gemini key for checking that a find photo matches the egg photo (optional).
# Without it, finds are counted on the honor system.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Free key from https://api-v3.mbta.com (optional, raises the rate limit).
MBTA_API_KEY=

PORT=3000
