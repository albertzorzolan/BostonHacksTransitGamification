# Copy to backend/.env and fill in. On Vercel, set these in Project Settings → Environment Variables.

# MongoDB (Atlas or any replica set; transactions need one). Leave empty for local
# dev to use a temporary in-memory MongoDB that's wiped on restart.
MONGODB_URI=
MONGODB_DB=egghunt
# Connections per instance.
DB_POOL_SIZE=10
# Tests use an in-memory MongoDB unless this is set (a random database is created and dropped).
TEST_MONGODB_URI=

# Browser origins allowed to call the API, comma-separated, or * for any.
# Auth uses bearer tokens (not cookies), so * is safe.
CORS_ORIGINS=*
# The local server also serves ../frontend. Set false when the frontend is hosted elsewhere.
SERVE_FRONTEND=true

# Gemini key for checking that a find photo matches the egg photo (optional).
# Without it, finds are counted on the honor system.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Free key from https://api-v3.mbta.com (optional, raises the rate limit).
MBTA_API_KEY=

PORT=3000
