# Copy to .env and fill in. Everything is optional.

# Gemini key for checking that a find photo matches the egg photo.
# Without it, finds are counted on the honor system.
GEMINI_API_KEY=
# Any Gemini model that accepts images. Check the current model list if this one errors.
GEMINI_MODEL=gemini-2.5-flash

# Free key from https://api-v3.mbta.com (raises the rate limit; works without one).
MBTA_API_KEY=

PORT=3000
